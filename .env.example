# Required for Gemini-based NER refinement
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Required for final answer generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Flask server
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=false

# Optional paths; relative paths are resolved from the project root
NORMALIZATION_PATH=data/normalization_dict.json
SLUG_MAP_PATH=data/slug_map.json
